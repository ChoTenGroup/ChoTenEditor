{
  "name": "choteneditor",
  "version": "1.2.11",
  "description": "ChoTenChan's plugin editor",
  "license": "MIT",
  "author": "AkaCandyKAngel",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder && node -e \"const fs=require('fs');try{fs.rmSync('release/win-unpacked',{recursive:true,force:true});fs.unlinkSync('release/builder-debug.yml');}catch(e){}console.log('Done')\""
  },
  "build": {
    "appId": "com.choten.editor",
    "productName": "ChotenEditor",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!node_modules/rcedit",
      "!.claude",
      "!.github",
      "!_ce_tmp",
      "!_ce_shots",
      "!_ce_*.js",
      "!test.log",
      "!_verify*.js",
      "!_t_*.js",
      "!_msg*.txt",
      "!_rel*.md",
      "!debug_*.js",
      "!**/._*"
    ],
    "icon": "icon.ico",
    "win": {
      "icon": "icon.ico",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "icon": "icon.png",
      "category": "Development",
      "maintainer": "AkaCandyKAngel <AkaCandyKAngel@users.noreply.github.com>",
      "synopsis": "Minecraft plugin configuration editor",
      "description": "An editor for CraftEngine / Kether / Chemdah plugin configuration.",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "${productName}.${version}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}.${version}.${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "rcedit": "^5.0.1"
  },
  "dependencies": {
    "codemirror": "^5.65.21",
    "js-yaml": "^4.1.1",
    "minimessage-js": "^2.0.1",
    "prismjs": "^1.30.0",
    "ws": "^8.20.1"
  }
}
