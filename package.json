{
  "name": "choteneditor",
  "version": "1.2.2",
  "description": "ChoTenChan's plugin editor",
  "license": "MIT",
  "author": "AkaCandyKAngel",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder && node -e \"const fs=require('fs');try{fs.rmSync('release/win-unpacked',{recursive:true,force:true});fs.unlinkSync('release/builder-debug.yml');}catch(e){}console.log('Done')\""
  },
  "build": {
    "appId": "com.choten.editor",
    "productName": "ChotenEditor",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!node_modules/rcedit",
      "!.claude",
      "!_ce_tmp",
      "!_ce_shots",
      "!_ce_*.js",
      "!test.log",
      "!_verify*.js",
      "!debug_*.js",
      "!**/._*"
    ],
    "icon": "icon.ico",
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "rcedit": "^5.0.1"
  },
  "dependencies": {
    "codemirror": "^5.65.21",
    "js-yaml": "^4.1.1",
    "minimessage-js": "^2.0.1",
    "prismjs": "^1.30.0",
    "ws": "^8.20.1"
  }
}
